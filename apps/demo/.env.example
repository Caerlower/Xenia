# Demo site (port 3001) — reads root monorepo `.env` for Sepolia + subgraph.
NEXT_PUBLIC_PRODUCT_URL=https://xenia.vercel.app

# Required in root `.env` for Run on-chain:
# SUBGRAPH_URL=
# XENIA_REGISTRY_ADDRESS=
# SEPOLIA_RPC_URL=
# HOST_PRIVATE_KEY=   # or PRIVATE_KEY / OPERATOR_PRIVATE_KEY — funds + stakes
# VICTIM_PRIVATE_KEY= # optional; defaults to the funder key
# STAKE_WEI=500000000000000
# PREMIUM_WEI=50000000000000
# DEMO_GAS_WEI=1200000000000000
# DEMO_FEE_BUFFER_WEI=1000000000000000
# DISPUTE_WINDOW_MS=10000
#
# Each Run mints fresh agent wallets and funds them from your key above.
# Budget ≈ 0.005 ETH (stakes + gas pads + premium top-up + fees).
# apps/api (x402) is NOT required for Run.
