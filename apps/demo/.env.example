# Demo site (port 3001) — reads root monorepo `.env` for Sepolia + subgraph.
NEXT_PUBLIC_PRODUCT_URL=https://xenia.vercel.app

# Required in root `.env` for demo Run (Sepolia + Hedera x402):
# SUBGRAPH_URL=
# XENIA_REGISTRY_ADDRESS=
# SEPOLIA_RPC_URL=
# HOST_PRIVATE_KEY=   # or PRIVATE_KEY / OPERATOR_PRIVATE_KEY — funds + stakes
# VICTIM_PRIVATE_KEY= # optional; defaults to the funder key
# HEDERA_SERVICE_ACCOUNT_ID=   # required — x402 payTo (Hedera testnet)
# HEDERA_SERVICE_PRIVATE_KEY=  # required
# HEDERA_PAYER_ACCOUNT_ID=     # must ≠ payTo; auto-provisioned if unset
# HEDERA_PAYER_PRIVATE_KEY=
# X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# X402_SERVICE_URL=http://localhost:4021
# STAKE_WEI=500000000000000
# PREMIUM_WEI=50000000000000
# DEMO_GAS_WEI=1200000000000000
# DEMO_FEE_BUFFER_WEI=1000000000000000
# DISPUTE_WINDOW_MS=10000
#
# Each Run mints fresh agent wallets and funds them from your key above.
# Budget ≈ 0.005 ETH (stakes + gas pads + premium top-up + fees) + ~0.002 HBAR (x402).
# Always run with the API: pnpm dev:api && pnpm dev:demo
