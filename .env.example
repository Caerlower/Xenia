# ── Shared ──────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
XENIA_REGISTRY_ADDRESS=0x8B71cd2dfDD7b8F774c84fF977EDF7839ceFDF28
DISPUTE_WINDOW=10
SUBGRAPH_URL=

# ── Hedera x402 / Blocky402 (required for demo Run) ─────
# Service account = payTo (receives ~0.001 HBAR per standing check).
HEDERA_SERVICE_ACCOUNT_ID=
HEDERA_SERVICE_PRIVATE_KEY=
# Distinct payer MUST ≠ payTo. If unset, demo auto-creates one → .xenia-hedera-payer.json
# HEDERA_PAYER_ACCOUNT_ID=
# HEDERA_PAYER_PRIVATE_KEY=
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_SERVICE_URL=http://localhost:4021
PORT=4021
HOST_API_TOKEN=
GUEST_API_TOKEN=

# ── ENS Sepolia (ENSv2) ─────────────────────────────────
ENS_PARENT_NAME=xenia.eth
ENS_OWNER_PRIVATE_KEY=
ENS_REGISTRY_ADDRESS=
ENS_RESOLVER_ADDRESS=
ENS_REGISTER_VALUE_WEI=0
HOST_ADDRESS=
HOST_PRIVATE_KEY=

# ── Demo agents ─────────────────────────────────────────
AGENT_A_PRIVATE_KEY=
AGENT_B_PRIVATE_KEY=
AGENT_C_PRIVATE_KEY=
VICTIM_PRIVATE_KEY=
AGENT_A_ADDRESS=
AGENT_B_ADDRESS=
AGENT_C_ADDRESS=
AGENT_A_BACKING_ID=
AGENT_B_BACKING_ID=
AGENT_A_STAKE=500000000000000
AGENT_B_STAKE=500000000000000
STAKE_WEI=500000000000000
PREMIUM_WEI=50000000000000
DEMO_GAS_WEI=1200000000000000
DEMO_FEE_BUFFER_WEI=1000000000000000
DISPUTE_WINDOW_MS=10000
DEMO_TRIGGER_URL=http://localhost:4021/health

# Demo Run requires: Sepolia funder key + SUBGRAPH_URL + HEDERA_SERVICE_* + pnpm dev:api
# apps/web register/vouch alone can skip Hedera; apps/mcp is optional.
